/data/*
# Written when tests/core.tests.ahk is run directly
tests/core.results.txt
# Manual test checklists stay local
tests/manual/
*.code-workspace
# Local Claude Code instructions
CLAUDE.md

# A version being worked on: its own checkout, made by maestro new-release.
# No slash at the end: maestro asks git about the folder before it exists.
/_*

# Copy made by the AHK parse check; left behind only if a check is interrupted
_syntaxcheck.ahk
# Windows Explorer files (frontend/assets/windows holds images)
Thumbs.db
desktop.ini
# Personal Claude Code settings (a shared .claude/settings.json can still be committed)
.claude/settings.local.json
